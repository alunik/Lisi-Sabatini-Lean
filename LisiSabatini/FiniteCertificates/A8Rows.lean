theorem row2_indexedClosure :
    indexedClosureCheck 64 row2At 0
      row2InverseIndex row2ProductIndex = true := by
  apply indexedClosureCheck_of_codedIndexedClosureCheck rowCode rowCode_injective
    composeCode8 rowCode_mul row2At row2CodeAt row2CodeAt_correct
    0 row2InverseIndex row2ProductIndex
  simpa only [rowCode_one] using row2_codedClosure

theorem row2_closed : subgroupCheck row2 = true := by
  exact subgroupCheck_finsetOfNodupList_of_arrayIndexedClosureCheck
    row2Elements row2Elements_nodup
    (0 : Fin 64) row2InverseIndex row2ProductIndex row2_indexedClosure

theorem row2_card_factorization :
    row2.card = 2 ^ (Nat.card G).factorization 2 := by
  rw [row2_card, card_G]
  decide +kernel

noncomputable def sylow2 : Sylow 2 G :=
  checkedSylow row2 row2_closed row2_card_factorization

@[simp] theorem mem_sylow2_iff (g : G) :
    g ∈ sylow2 ↔ g ∈ row2 := Iff.rfl

theorem sylow2_card : Nat.card sylow2 = 64 := by
  change Nat.card (checkedSubgroup row2 row2_closed) = 64
  exact (card_checkedSubgroup row2 row2_closed).trans row2_card

