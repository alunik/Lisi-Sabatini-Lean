def row2ProductIndex (i j : Fin 64) : Fin 64 :=
  (row2ProductRows[i.val]'(by change i.val < 64; exact i.isLt)) j

/-- A fixed row needs one inverse and 64 product checks.
Separate proof declarations bound each kernel reduction's working set. -/
def row2CodedRowCheck (i : Fin 64) : Bool :=
  decide (composeCode8 (row2CodeAt (row2InverseIndex i))
    (row2CodeAt i) = 342391) &&
    (List.finRange 64).all (fun j ↦ decide
      (row2CodeAt (row2ProductIndex i j) =
        composeCode8 (row2CodeAt i) (row2CodeAt j)))

